{
  "openapi": "3.0.0",
  "info": {
    "title": "City Fix API",
    "version": "1.0.0",
    "description": "API REST para la gestión de incidencias municipales."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor Local"
    },
    {
      "url": "https://cityfix-backend-13xy.onrender.com",
      "description": "Servidor Producción (Render)"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Iniciar sesión",
        "tags": ["Autenticación"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Token JWT generado" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Obtener perfil actual",
        "tags": ["Autenticación"],
        "responses": {
          "200": { "description": "Datos del usuario actual" }
        }
      }
    },
    "/incidencias/stats": {
      "get": {
        "summary": "Estadísticas globales (Admin)",
        "tags": ["Incidencias"],
        "responses": {
          "200": { "description": "Datos estadísticos" }
        }
      }
    },
    "/incidencias": {
      "get": {
        "summary": "Listar todas las incidencias",
        "tags": ["Incidencias"],
        "responses": {
          "200": { "description": "Lista de incidencias" }
        }
      },
      "post": {
        "summary": "Crear nueva incidencia",
        "tags": ["Incidencias"],
        "responses": {
          "201": { "description": "Incidencia creada" }
        }
      }
    },
    "/incidencias/{id}": {
      "get": {
        "summary": "Obtener incidencia por ID",
        "tags": ["Incidencias"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Detalles de la incidencia" }
        }
      },
      "put": {
        "summary": "Actualizar estado (Admin)",
        "tags": ["Incidencias"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Estado actualizado" }
        }
      },
      "delete": {
        "summary": "Eliminar incidencia",
        "tags": ["Incidencias"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Incidencia eliminada" }
        }
      }
    },
    "/categorias": {
      "get": {
        "summary": "Listar categorías",
        "tags": ["Categorías"],
        "security": [],
        "responses": {
          "200": { "description": "Lista de categorías" }
        }
      }
    },
    "/anuncios": {
      "get": {
        "summary": "Listar anuncios",
        "tags": ["Noticias"],
        "security": [],
        "responses": {
          "200": { "description": "Lista de anuncios" }
        }
      },
      "post": {
        "summary": "Crear anuncio (Admin)",
        "tags": ["Noticias"],
        "responses": {
          "201": { "description": "Anuncio creado" }
        }
      }
    },
    "/contacto": {
      "get": {
        "summary": "Obtener datos de contacto",
        "tags": ["Contacto"],
        "security": [],
        "responses": {
          "200": { "description": "Datos de contacto del ayuntamiento" }
        }
      },
      "put": {
        "summary": "Actualizar contacto (Admin)",
        "tags": ["Contacto"],
        "responses": {
          "200": { "description": "Datos actualizados" }
        }
      }
    },
    "/usuarios/{id}/bloquear": {
      "put": {
        "summary": "Bloquear usuario (Admin)",
        "tags": ["Usuarios"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Estado de bloqueo actualizado" }
        }
      }
    }
  }
}
